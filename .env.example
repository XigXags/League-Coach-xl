# League Coach settings. Copy this file to .env and fill in the values you need.
# .env is ignored by git; never commit real keys. Variables already set in your
# shell take priority over this file, and blank lines here are ignored.

# --- Required ---------------------------------------------------------------
# Discord bot token from the Developer Portal (Bot > Token).
DISCORD_BOT_TOKEN=
# TypeSafe key used by Jev to rank options. Without it there is no recommendation.
TYPESAFE_API_KEY=

# --- Discord ----------------------------------------------------------------
# Test server ID for immediate slash-command registration.
DISCORD_GUILD_ID=

# --- Intent router (OpenAI-compatible chat-completions endpoint) --------------
COACH_ROUTER_URL=
COACH_ROUTER_MODEL=
COACH_ROUTER_API_KEY=

# --- Optional model providers (names referenced by coach_models.json) ---------
OPENAI_API_KEY=
COACH_OPENAI_MODEL=
ANTHROPIC_API_KEY=
COACH_ANTHROPIC_MODEL=
COACH_LOCAL_MODEL=

# --- Riot Match-V5 research (riot_timelines.py only) ---------------------------
RIOT_API_KEY=

# --- Behaviour (defaults shown; uncomment to change) ---------------------------
# COACH_MOCK=1                      # offline development without a live game
# COACH_HOTKEY_VK=0xBD              # push-to-talk key, Windows virtual-key code (- key)
# COACH_SCOREBOARD=1                # 0 turns the scoreboard reader off
# COACH_SCOREBOARD_VK=0x09          # scoreboard key (Tab)
# COACH_SCOREBOARD_RECT=            # left,top,width,height override
# COACH_MINIMAP=1                   # 0 turns the minimap reader off
# COACH_MINIMAP_RECT=               # left,top,width,height override
# COACH_VOICE=en-US-SteffanNeural
# COACH_VOICE_RATE=+30%
# COACH_VOICE_PITCH=-6Hz
# COACH_VOICE_VOLUME=+5%
